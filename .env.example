# ──────────────────────────────────────────────────────────────────────────────
# Student Productivity Agent — Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to version control.
# The .env file is already listed in .gitignore.

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Supported: groq | openai | anthropic
# Groq is the recommended provider — it is free to use with generous limits.

# ── Groq (recommended) ────────────────────────────────────────────────────────
# Get a free API key at: https://console.groq.com
# Supported models: llama-3.3-70b-versatile | llama-3.1-8b-instant | gemma2-9b-it
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=your-groq-api-key-here

# ── OpenAI (alternative) ──────────────────────────────────────────────────────
# Uncomment and fill in if you want to use OpenAI instead.
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=your-openai-api-key-here

# ── Anthropic (alternative) ───────────────────────────────────────────────────
# Uncomment and fill in if you want to use Anthropic instead.
# Also run: pip install langchain-anthropic
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-5-haiku-20241022
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite file path (relative to the project root)
DATABASE_URL=sqlite:///./student_productivity.db

# ── API Server ─────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000

# ── App Settings ───────────────────────────────────────────────────────────────
DEBUG=True
